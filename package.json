{
  "name": "cutmyhair",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @cutmyhair/api run start:dev",
    "dev:web": "yarn workspace @cutmyhair/web run dev",
    "dev:mobile": "yarn workspace @cutmyhair/mobile run start",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "expo": "~58.0.17",
    "turbo": "^2.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "react-native-web": "^0.21.4"
  }
}
