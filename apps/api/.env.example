# CutMyHair API Environment Configuration

# Server port (default 3000)
PORT=3000

# Environment mode: development | production | test
NODE_ENV=development

# Secret used to sign HMAC customer auth session tokens
AUTH_SECRET=dev-auth-secret-key-change-in-production

# Secret used to sign check-in HMAC codes
CHECKIN_SECRET=dev-checkin-secret-change-in-production

# Fixed OTP code for development testing (leave empty to generate random 6-digit codes)
DEV_FIXED_OTP=123456

# Provider selection (defaults to "mock")
PAYMENT_PROVIDER=mock
GEO_PROVIDER=mock
OTP_PROVIDER=mock

# Billplz configuration (used when PAYMENT_PROVIDER=billplz)
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_SECRET_KEY=
BILLPLZ_XSIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=

# Public API URL used for payment webhooks and callbacks
PUBLIC_API_URL=http://localhost:3000/api

# Google Maps API key (used when GEO_PROVIDER=google)
GOOGLE_MAPS_API_KEY=

# Resend API key (used when OTP_PROVIDER=resend)
RESEND_API_KEY=
