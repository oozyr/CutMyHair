# CutMyHair Mobile App Environment Configuration

# API Base URL
# For local emulator / web:
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# For testing on physical phone via Expo Go on the same Wi-Fi:
# Replace with your PC local IPv4 address (e.g. from ipconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3000/api

# Google Maps API Key for map integration
GOOGLE_MAPS_API_KEY=
